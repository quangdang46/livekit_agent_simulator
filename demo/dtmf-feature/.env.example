# ---- LiveKit ----
# Cloud: https://cloud.livekit.io → project settings. Self-hosted: your server URL + key/secret.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_api_secret
# Registered worker name — MUST match the agent_name in .agent-sim/config.yaml
AGENT_NAME=dtmf-demo-local

# ---- Provider keys ----
# Agent speech stack (Google Gemini Live recommended; OpenAI Realtime alternative below)
GOOGLE_API_KEY=AIza...
# Only needed if you switch the agent to the OpenAI realtime stack
OPENAI_API_KEY=sk-...
# STT + TTS plugins (falls back to OpenAI whisper/tts if unset)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# ---- Simulator caller brain (lks) ----
# google (Gemini Live) or openai — must match .agent-sim/config.yaml simulator.provider
SIM_CALLER_API_KEY=AIza...

# ---- Agent model stack ----
# AGENT_STACK=openai   -> openai LLM (gpt-4.1-mini) + openai TTS/STT
# AGENT_STACK=gemini   -> google LLM via LiveKit Inference (google/gemini-*) + openai TTS/STT
AGENT_STACK=openai
# GEMINI_LLM=google/gemini-2.5-flash
# OPENAI_LLM=gpt-4.1-mini
# OPENAI_VOICE=nova
